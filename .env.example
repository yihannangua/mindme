# 本地后端示例。复制为 .env 后使用 node --env-file=.env 运行。
NODE_ENV=development
AUTH_MODE=passkey
PUBLIC_ORIGIN=http://localhost:3180
HOST=127.0.0.1
PORT=3180
DATABASE_PATH=./data/mindme.sqlite
STATIC_DIR=./dist
# 用 node:crypto 生成至少 32 字符的随机字符串并替换，不得使用测试字符串。
SESSION_SECRET=替换为生成的随机密钥
DEV_AUTH=false
# 首次部署只允许显式初始化或完整导入后开始业务服务。
MIGRATION_REQUIRED=true
